execute_process(COMMAND "${NM}" --defined-only --format=posix "${LOADER}" OUTPUT_VARIABLE SYMBOLS COMMAND_ERROR_IS_FATAL ANY)
foreach(NAME _start pokedata_workaround)
    string(REGEX MATCH "(^|\n)${NAME} [^ ]+ ([0-9a-fA-F]+)" MATCH "${SYMBOLS}")
    if(NOT MATCH)
        message(FATAL_ERROR "loader 缺少 ${NAME}")
    endif()
    set(${NAME} "0x${CMAKE_MATCH_2}")
endforeach()
math(EXPR OFFSET "${pokedata_workaround} - ${_start}")
file(WRITE "${OUTPUT}" "#include <unistd.h>\nconst ssize_t offset_to_pokedata_workaround = ${OFFSET};\n")
