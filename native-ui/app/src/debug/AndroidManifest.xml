<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:networkSecurityConfig,android:usesCleartextTraffic">
        <activity
            android:name=".StartupGateTestActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <receiver
            android:name=".data.backup.RestoreRelayDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.promenar.nexara.debug.TEST_RESTORE_RELAY" />
            </intent-filter>
        </receiver>
        <activity android:name=".ui.settings.SecretFieldTestActivity" android:exported="false" />
        <activity android:name=".ui.settings.BackupTestActivity" android:exported="false" />
    </application>
</manifest>
