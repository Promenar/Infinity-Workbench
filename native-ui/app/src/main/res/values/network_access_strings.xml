    <string name="network_section_controls">What you can change</string>
    <string name="network_section_controls_footer">The allowlist covers web reading, media downloads and script networking; tailnet devices also follow the Tailscale device allowlist. Plain http works only for 127.0.0.1.</string>
    <string name="network_section_matrix">Reach by tool</string>
    <string name="network_section_matrix_footer">Built-in commands and Termux use the system network. SSH connects only to saved hosts.</string>

    <string name="network_lan_hosts_title">Local network and device allowlist</string>
    <string name="network_lan_hosts_desc">One host name or IP per line, without scheme, port or path. Local network services need https; plain http works only for 127.0.0.1.</string>
    <string name="network_lan_hosts_save">Save allowlist</string>
    <string name="network_lan_hosts_invalid">Enter up to 64 exact host names or IPs, without scheme, port, path or wildcards.</string>
